#usda 1.0
(
    defaultPrim = "Root"
    doc = """Colon surface material (final, UV-based, no tiling).
Generated from /home/hans/projects/arcgym/src/arcgym/assets/colons/materials/colon_surface_material.usd
"""
    upAxis = "Z"
)

def Xform "Root"
{
    def Material "OmniSurface"
    {
        token outputs:mdl:displacement.connect = </Root/OmniSurface/Shader.outputs:out>
        token outputs:mdl:surface.connect      = </Root/OmniSurface/Shader.outputs:out>
        token outputs:mdl:volume.connect       = </Root/OmniSurface/Shader.outputs:out>

        token ui:displayGroup = "Material Graphs"
        token ui:displayName  = "OmniSurface"
        int   ui:order        = 1024

        def Shader "Shader"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset      = @OmniSurface.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "OmniSurface"

            # Base color texture (use mesh UVs)
            asset inputs:diffuse_reflection_color_image = @../textures/colon_texture_test.png@ (
                colorSpace = "sRGB"
            )

            # ---- Optical properties (unchanged) ----
            float inputs:diffuse_reflection_weight        = 0.4
            bool  inputs:enable_diffuse_transmission      = 1
            float inputs:specular_reflection_weight       = 0.1
            float inputs:specular_reflection_roughness    = 0.1
            float inputs:subsurface_weight                = 0.2

            # ---- UV configuration (CRITICAL FIX) ----
            # Use mesh UV coordinates
            int   inputs:uvw_projection_mode              = 0   # UV coordinates
            int   inputs:uvw_texture_coordinate_system    = 1   # UV set 0
            float inputs:uvw_s_scale                      = 1.0
            float inputs:uvw_t_scale                      = 1.0

            token outputs:out (
                renderType = "material"
            )
        }
    }
}
